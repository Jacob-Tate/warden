# warden configuration (all optional unless noted)

# SQLite database file (parent directory is created if missing)
WARDEN_DB_PATH=./data/warden.db
# Address to listen on (put an HTTPS reverse proxy in front)
WARDEN_BIND=0.0.0.0:8080
# Externally visible base URL, used for OAuth metadata and links
WARDEN_PUBLIC_URL=https://warden.example.com
# Comma-separated static API keys accepted as bearer tokens (generate long random values)
WARDEN_API_KEYS=
# Hash of the owner passphrase used on the OAuth consent page (Phase 2; e.g. argon2 PHC string)
WARDEN_OWNER_PASSPHRASE_HASH=
# Optional NVD API key (raises the rate limit from 5 to 50 requests / 30 s)
NVD_API_KEY=
# Seconds between sync runs (default 3600)
WARDEN_SYNC_INTERVAL_SECS=3600
# Log filter (tracing EnvFilter syntax)
RUST_LOG=info,warden=debug
