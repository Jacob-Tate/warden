# warden configuration (all optional unless noted)

# SQLite database file (parent directory is created if missing)
WARDEN_DB_PATH=./data/warden.db
# Address to listen on (put an HTTPS reverse proxy in front)
WARDEN_BIND=0.0.0.0:8080
# Externally visible base URL, used for OAuth metadata and links
WARDEN_PUBLIC_URL=https://warden.example.com
# Comma-separated `name:sha256hex` API key entries; create with `warden hash-key <name>`
# (the name is the client's default consumer)
WARDEN_API_KEYS=
# Enables the built-in OAuth server (claude.ai custom connectors). Argon2id hash of the owner
# passphrase; create with `warden hash-passphrase` and single-quote it (double each $ as $$ in compose).
# Unset = OAuth endpoints return 404 and only API keys work.
WARDEN_OWNER_PASSPHRASE_HASH=
# Allowed OAuth redirect URIs, comma-separated; `scheme://host:*` allows any port and path.
# Default: Claude's hosted callbacks (claude.ai, claude.com) plus http loopback (localhost, 127.0.0.1, [::1]).
# WARDEN_OAUTH_REDIRECT_ALLOW=https://claude.ai/api/mcp/auth_callback,http://localhost:*,http://127.0.0.1:*
# Refresh-token lifetime in days (sliding, rotated on use; default 30)
# WARDEN_OAUTH_REFRESH_DAYS=30
# Dynamic client registration (/register): open (default) or closed. Close it once your
# connector is registered; existing connectors keep working.
# WARDEN_OAUTH_REGISTRATION=open
# Reverse proxies (IPs/CIDRs) whose X-Forwarded-For / Forwarded / X-Real-IP are trusted for
# per-client rate limiting. Set this when behind a proxy; empty = use the TCP peer address.
# It must be the proxy AS THE CONTAINER SEES IT: in Docker that is the bridge gateway
# (172.16.0.0/12 covers every default bridge) or the proxy container's network, not 127.0.0.1.
WARDEN_TRUSTED_PROXIES=
# Optional NVD API key (raises the rate limit from 5 to 50 requests / 30 s)
NVD_API_KEY=
# Time between sync runs: seconds or 30m / 1h / 1d (default 1h; WARDEN_SYNC_INTERVAL_SECS also works)
WARDEN_SYNC_INTERVAL=1h
# Days to keep CVEs that match no tracked product (default 180)
WARDEN_RETENTION_DAYS=180
# Days before a product was added in which CVEs still count as new (default 14)
WARDEN_BACKFILL_DAYS=14
# Log filter (tracing EnvFilter syntax)
RUST_LOG=info,warden=debug
